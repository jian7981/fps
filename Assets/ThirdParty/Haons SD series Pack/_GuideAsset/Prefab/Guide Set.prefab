--- !u!102 &7796045840126159779
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3995789104363174518}
  m_Text: "-You can create your own character model \r\nthat is compatible with the
    format of Haon SD series.\r\nCompared to Haon's assets, they can also be sold
    \r\nat the Asset Store if they have enough original design. \r\nYou do not need
    to ask Haon for permission.\r\nIn this case, Unity-chan license will apply.\r\n\r\n(Optional)\r\nIf
    you mark the package as \"Compatible with Haon SD\" \r\nHaon will promote your
    package together.\r\n\r\nIntroducing your package on Haon's social media.\r\n\r\n"
  m_OffsetZ: 0
  m_CharacterSize: 0.1
  m_LineSpacing: 1
  m_Anchor: 0
