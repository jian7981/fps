--- !u!102 &5114338960696120362
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1982917714875324187}
  m_Text: "How to Use RigProp Animation\r\n\r\n1. Add a RigProp(*R_Broomstick1, R_Umbrella,
    L_FryingPanEggIn1) prefab as a child of the 'Prop_R/L' node.\r\n2. Rename the
    RigProp prefab to 'Prf_RigProp_UseAnim'.\r\n3. If the RigProp has Springbone
    applied, disable the 'Springbone Manager (script)' component of the RigProp prefab.
    \r\nKey animation and spring physics simulation cannot be used simultaneously."
  m_OffsetZ: 0
  m_CharacterSize: 0.02
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 0
  m_FontStyle: 0
